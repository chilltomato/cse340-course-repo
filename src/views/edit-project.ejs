<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

 <form action="/new-project" method="POST">
    <div class="form-group">
      <label for="title">Project Title</label>
      <input
        type="text"
        id="title"
        name="title"
        value="<%= projectDetails.title %>"
        maxlength="150"
        required
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        maxlength="500"
        required
      ><%= projectDetails.description %></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        value="<%= projectDetails.place %>"
        maxlength="255"
        required
      />
    </div>

    <div class="form-group">
      <label for="date">Date</label>
      <input
        type="date"
        id="date"
        name="date"
        value="<%= new Date(projectDetails.thedate).toISOString().split('T')[0]  %>"
        required
      />
    </div>

    <div class="form-group">
    <label>Organizations</label>

    <% organizations.forEach(org => { %>
        <div>
            <input
                type="checkbox"
                id="org-<%= org.organization_id %>"
                name="organizationIds"
                value="<%= org.organization_id %>"
                <%= projectDetails.organizations.some(
                    organization => organization.organization_id === org.organization_id
                ) ? 'checked' : '' %>
            />
            <label for="org-<%= org.organization_id %>">
                <%= org.name %>
            </label>
        </div>
    <% }); %>
</div>

    <button type="submit">Edit Project</button>

</main>
<%- include('partials/footer') %>
