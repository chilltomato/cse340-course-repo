<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
        <h2>Here are some Service Projects from our partner organizations</h2>
        <h3>some that have been done, and some that will do in the future</h2>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <h3> <%= project.title %></h3>
                    <p><small> <%= project.organizations[0].name %></small></p>
                    <strong> <%= project.description %></strong>
                    <div class="dateandplace">
                        <p><%= project.place %></p>
                        <p><%= new Date(project.thedate).toISOString().split('T')[0]  %></p>
                    </div>
                   
                </li>
            <% }); %>
        </ul>
</main>
<%- include('partials/footer') %>