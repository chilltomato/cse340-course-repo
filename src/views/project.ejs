<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= projectDetails.title %></h2>

    <p>Description: <%= projectDetails.description %></p>
    <div class="dateandplace">
                        <p><%= projectDetails.place %></p>
                        <p><%= new Date(projectDetails.thedate).toISOString().split('T')[0]  %></p>
                    </div>
    <h3>Organizations Involved</h3>
    <ul>
        <% projectDetails.organizations.forEach(organization => { %>
            <li>
                <a href="/organization/<%= organization.organization_id %>">
                    <%= organization.name %>
                </a>
            </li>
        <% }) %>
    </ul>
    <h3>categories:</h3>
    <ul>
        <% categories.forEach(category => { %>
        <li><a href="/category/<%= category.category_id %>"><%= category.category_name %></a></li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>
